# Zero-Magic Backend Environment Configuration
# Get your free API keys at https://console.groq.com/keys

# Primary key — used for Socratic mission generation + expert solutions
GROQ_API_KEY=your_primary_groq_api_key_here

# Secondary key — dedicated to the Tier Classifier service (POST /v1/missions/classify-tier)
# Using a separate key keeps classifier latency isolated from mission generation quota.
GROQ_API_KEY1=your_secondary_groq_api_key_here

# Optional key — used for LLM enrichment in llm_service.py
OPENAI_API_KEY=your_openai_api_key_here
